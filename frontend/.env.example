# ======================================================================
# ABiTA frontend — salin ke .env
# ======================================================================

# URL backend yang dipanggil browser. Dibaca saat npm run dev dan npm run build; build ulang setelah diubah.
# Nilai production dapat disimpan di .env.production.
#   Pengembangan    : http://localhost:3001 (gunakan localhost, bukan 127.0.0.1, agar cookie sesi terkirim)
#   Subdomain       : https://api.example.com (PUBLIC_APP_URL backend = URL frontend ini)
#   Origin yang sama: kosongkan (backend pada https://example.com/api)
API_URL=http://localhost:3001

# Port server frontend (npm run dev / npm start)
WEB_PORT=3000
