# ======================================================================
# ABiTA backend (API) — salin ke .env
# ======================================================================

# --- Database MySQL (XAMPP: user root tanpa kata sandi, kelola lewat phpMyAdmin) ---
DATABASE_URL=mysql://root:@127.0.0.1:3306/abita

# --- Keamanan ---
# Wajib diganti di production: string acak panjang (mis. hasil `openssl rand -hex 32`)
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_TTL_HOURS=12

# --- Port API ---
API_PORT=3001

# --- Identitas ---
ORG_NAME=RS Awal Bros Botania
TZ_NAME=Asia/Jakarta

# --- Akses lintas origin ---
# URL frontend, tanpa garis miring di akhir. Digunakan untuk tautan email dan sebagai origin CORS.
PUBLIC_APP_URL=http://localhost:3000
# Origin tambahan yang diizinkan, dipisahkan koma.
CORS_ORIGINS=
# lax: frontend dan API pada domain induk yang sama. none: domain berbeda (memerlukan HTTPS).
COOKIE_SAMESITE=lax

# --- File (relatif terhadap folder backend) ---
STORAGE_DIR=storage
MODELS_DIR=models
MAX_ATTACHMENT_MB=8
MAX_DOCUMENT_MB=10

# --- Presensi ---
SESSION_TTL_SECONDS=90
REJECT_MOCK_LOCATION=true
MAX_GPS_ACCURACY_M=0
GPS_ACCURACY_ALLOWANCE_MAX_M=100
# Jendela check in/out diatur di dasbor: Pengaturan › Jam shift

# --- Pengenalan wajah (SFace cosine; orang sama 0.70–0.92, orang lain 0.33–0.41) ---
MATCH_THRESHOLD=0.50
# Kualitas foto wajah: lebar wajah minimal (porsi lebar foto), kecerahan 0–255, ketajaman (0 = tidak dicek;
# nilai tiap percobaan tercatat di attempts.scores — setelah ada data, ~30 menolak foto sangat buram)
MIN_FACE_WIDTH=0.15
MIN_FACE_BRIGHTNESS=40
MAX_FACE_BRIGHTNESS=235
MIN_FACE_SHARPNESS=0
CONSISTENCY_THRESHOLD=0.45
SECOND_FACE_MAX_RATIO=0.8

# --- Batas laju API (per akun / per IP, per menit) ---
API_RATE_PER_MIN=300
# Permintaan tanpa sesi, per IP
API_RATE_PER_MIN_IP=1200

# --- Production ---
# Jumlah koneksi MySQL per proses (di bawah max_user_connections hosting)
DB_POOL_SIZE=10
# Aktifkan Swagger (/api/docs) di production
API_DOCS=false
# Masa berlaku sesi aplikasi karyawan dengan opsi "Ingat saya" (hari)
SESSION_REMEMBER_DAYS=30
FACE_SUBMIT_PER_MIN=10

# --- Log API ---
# LOG_LEVEL: error | warn | info | debug
LOG_LEVEL=info
# LOG_REQUESTS: errors (hanya 4xx/5xx & lambat) | all | off
LOG_REQUESTS=errors
# LOG_FORMAT: text | json
LOG_FORMAT=text
